#! /etc/profiles/per-user/cloudgenius/bin/zsh
set -e

# Redirect any potential private key output to /dev/null
exec 3>&1
trap 'exec 1>&3' EXIT

# Unlock your vault first (redirect output to prevent session token display)
echo "Unlocking Bitwarden vault..."
BW_SESSION=$(bw unlock --raw)
export BW_SESSION
echo "Vault unlocked successfully."

echo "Syncing Bitwarden vault..."
bw sync >/dev/null 2>&1
echo "Vault synced successfully."

# Check if jq is installed  
if ! command -v jq &> /dev/null; then
  echo "jq could not be found. Please install jq to proceed."
  exit 1
fi
# Check if bw is installed
if ! command -v bw &> /dev/null; then
  echo "Bitwarden CLI (bw) could not be found. Please install it to proceed."
  exit 1
fi
# Check if SSH keys exist
if [ ! -f ~/.ssh/id_ed25519 ]; then
  echo "SSH key ~/.ssh/id_ed25519 does not exist. Please generate an SSH key first."
  exit 1
fi
if [ ! -f ~/.ssh/id_ed25519.pub ]; then
  echo "SSH public key ~/.ssh/id_ed25519.pub does not exist. Please generate an SSH key first."
  exit 1
fi

# Create a folder for SSH Keys only if it doesn't exist
FOLDER_NAME="SSH Keys"
FOLDER_EXISTS=$(bw list folders | jq -r --arg name "$FOLDER_NAME" '.[] | select(.name==$name) | .id')

echo "Checking if folder '$FOLDER_NAME' exists..."
if [ -n "$FOLDER_EXISTS" ]; then
  echo "Folder '$FOLDER_NAME' already exists with ID: $FOLDER_EXISTS"
else
  echo "Folder '$FOLDER_NAME' does not exist."
fi

if [ -z "$FOLDER_EXISTS" ]; then
  echo "Creating '$FOLDER_NAME' folder..."
  bw get template folder | jq --arg name "$FOLDER_NAME" '.name=$name' | bw encode | bw create folder >/dev/null
fi

# Get the folder ID
FOLDER_ID=$(bw list folders | jq -r --arg name "$FOLDER_NAME" '.[] | select(.name==$name) | .id')

echo "Folder ID for '$FOLDER_NAME': $FOLDER_ID"

# Check if secure note for SSH key already exists
ITEM_NAME="id_ed25519"
ITEM_EXISTS=$(bw list items | jq -r --arg name "$ITEM_NAME" '.[] | select(.name==$name) | .id')

# Delete the existing item if it exists
if [ -n "$ITEM_EXISTS" ]; then
  echo "Deleting existing '$ITEM_NAME' secure note..."
  bw delete item $ITEM_EXISTS >/dev/null
fi

# Create a new secure note
echo "Creating secure note '$ITEM_NAME'..."
# Redirect output to hide any sensitive data
bw get template item | \
  jq --arg fid "$FOLDER_ID" \
     '.folderId = $fid | .name = "id_ed25519" | .type = 2 | .secureNote.type = 0' | \
  bw encode | bw create item >/dev/null

# Get the new item ID
ITEM_ID=$(bw list items | jq -r --arg name "$ITEM_NAME" '.[] | select(.name==$name) | .id')

echo "Secure note ID for '$ITEM_NAME': $ITEM_ID"

# Add private key (redirect all outputs to prevent key display)
echo "Adding private key to secure note..."
# Read private key into variable without displaying it
PRIVATE_KEY=$(cat ~/.ssh/id_ed25519 2>/dev/null)
# Process and add the key with all output suppressed
bw get item $ITEM_ID 2>/dev/null | \
  jq --arg key "$PRIVATE_KEY" \
     '.fields = [{"name": "private key", "value": $key, "type": 1}]' 2>/dev/null | \
  bw encode 2>/dev/null | bw edit item $ITEM_ID >/dev/null 2>&1

# Clear the variable containing the private key
PRIVATE_KEY=""

# Add the public key (as a second field to the same item)
echo "Adding public key to secure note..."
PUBLIC_KEY=$(cat ~/.ssh/id_ed25519.pub 2>/dev/null)
bw get item $ITEM_ID 2>/dev/null | \
  jq --arg key "$PUBLIC_KEY" \
     '.fields += [{"name": "public key", "value": $key, "type": 0}]' 2>/dev/null | \
  bw encode 2>/dev/null | bw edit item $ITEM_ID >/dev/null 2>&1

echo "Verification that the item exists (without displaying sensitive data):"
bw get item $ITEM_ID 2>/dev/null | jq -r '.name' 2>/dev/null || echo "Failed to verify item"

echo "SSH keys have been successfully added to Bitwarden."
echo "You can now access your SSH keys in the '$FOLDER_NAME' folder in Bitwarden."
echo "Script completed successfully."
echo "Please remember to lock your Bitwarden vault after use."
echo "Locking Bitwarden vault..."
bw lock >/dev/null 2>&1
echo "Bitwarden vault locked."
echo "Script execution completed."

# Clean up any environment variables that might contain sensitive data
unset BW_SESSION PRIVATE_KEY PUBLIC_KEY